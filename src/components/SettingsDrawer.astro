---
---
<!-- Settings Drawer Backdrop -->
<div
  id="settings-backdrop"
  class="fixed inset-0 z-50 bg-black/70 opacity-0 pointer-events-none transition-opacity duration-200"
  aria-hidden="true"
></div>

<!-- Settings Drawer Panel -->
<aside
  id="settings-drawer"
  class="glass-modal interface-drawer fixed top-0 right-0 z-50 h-full w-full max-w-[380px] translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between p-6 border-l border-white/10"
  aria-label="Параметри інтерфейсу"
>
  <div>
    <!-- Drawer Header -->
    <div class="flex items-center justify-between pb-5 mb-6" style="box-shadow: inset 0 -1px 0 0 var(--c-divider);">
      <div>
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] block mb-0.5 text-muted">КОНФІГУРАЦІЯ</span>
        <h2 class="text-[17px] font-semibold tracking-[-0.02em] text-fg" data-i18n="settings.title">Параметри інтерфейсу</h2>
      </div>
      <button
        id="close-settings-btn"
        type="button"
        class="w-8 h-8 rounded-full liquid-pill flex items-center justify-center transition-colors cursor-pointer text-muted hover:text-fg"
        aria-label="Закрити налаштування"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="space-y-6">
      <!-- 0. Telegram Profile / Sign-In Block -->
      <div>
        <label class="font-mono text-[10px] uppercase tracking-[0.12em] block mb-2.5 text-muted" data-i18n="settings.profileLabel">
          Акаунт та профіль
        </label>
        <button
          id="drawer-auth-btn"
          type="button"
          class="liquid-pill w-full rounded-xl p-3.5 flex items-center justify-between gap-3 cursor-pointer text-left transition-all hover:border-white/25 group"
        >
          <!-- Guest State -->
          <div id="drawer-auth-guest" class="flex items-center gap-3 min-w-0 flex-1">
            <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 border border-white/15" style="background: var(--bg-surface-2);">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <span class="text-[13px] font-semibold block text-fg truncate" data-i18n="auth.signInTelegram">Увійти через Telegram</span>
              <span class="text-[11px] block text-muted truncate" data-i18n="settings.profileGuestHint">
                Натисніть для швидкого входу через Telegram
              </span>
            </div>
          </div>

          <!-- Authed User State -->
          <div id="drawer-auth-user" class="hidden items-center gap-3 min-w-0 flex-1">
            <div class="w-10 h-10 rounded-full p-[1.5px] bg-gradient-to-tr from-[#3b82f6] via-white/80 to-[#60a5fa] shrink-0 overflow-hidden flex items-center justify-center">
              <img
                id="drawer-user-avatar"
                src=""
                alt="User Avatar"
                class="w-full h-full rounded-full object-cover hidden"
              />
              <span
                id="drawer-user-initials"
                class="w-full h-full rounded-full bg-zinc-900 text-white font-bold text-[12px] flex items-center justify-center uppercase"
              >
                AX
              </span>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span id="drawer-user-name" class="text-[13px] font-semibold text-fg truncate">Rider</span>
              </div>
              <span id="drawer-user-handle" class="font-mono text-[11px] block text-muted truncate">@username</span>
            </div>
          </div>

          <svg class="w-4 h-4 text-muted group-hover:text-fg transition-transform group-hover:translate-x-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>

      <!-- 1. Language Switcher (Українська / English) -->
      <div>
        <label class="font-mono text-[10px] uppercase tracking-[0.12em] block mb-2.5 text-muted" data-i18n="settings.langLabel">
          Мова інтерфейсу
        </label>
        <div class="grid grid-cols-2 gap-2 p-1 rounded-xl border border-white/10" style="background: var(--bg-surface-2);">
          <button
            type="button"
            data-lang-btn="uk"
            class="drawer-lang-btn active py-2.5 px-3 rounded-lg text-[12px] font-medium transition-all cursor-pointer text-center"
          >
            Українська
          </button>
          <button
            type="button"
            data-lang-btn="en"
            class="drawer-lang-btn py-2.5 px-3 rounded-lg text-[12px] font-medium transition-all cursor-pointer text-center"
          >
            English
          </button>
        </div>
      </div>

      <!-- 2. Theme Switcher (OLED Dark / Clean Light) -->
      <div>
        <label class="font-mono text-[10px] uppercase tracking-[0.12em] block mb-2.5 text-muted" data-i18n="settings.themeLabel">
          Кольорова схема
        </label>
        <div class="grid grid-cols-2 gap-2 p-1 rounded-xl border border-white/10" style="background: var(--bg-surface-2);">
          <button
            type="button"
            data-theme-btn="dark"
            class="theme-opt-btn active py-2.5 px-3 rounded-lg text-[12px] font-medium transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span class="w-2 h-2 rounded-full bg-white"></span>
            <span data-i18n="settings.themeDark">Темна OLED</span>
          </button>
          <button
            type="button"
            data-theme-btn="light"
            class="theme-opt-btn py-2.5 px-3 rounded-lg text-[12px] font-medium transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span class="w-2 h-2 rounded-full bg-zinc-400"></span>
            <span data-i18n="settings.themeLight">Світла тема</span>
          </button>
        </div>
      </div>

      <!-- 3. Optical Render Mode (Liquid Glass vs Performance Mode) -->
      <div>
        <label class="font-mono text-[10px] uppercase tracking-[0.12em] block mb-2.5 text-muted" data-i18n="settings.perfLabel">
          Графічний режим
        </label>
        <div class="liquid-pill rounded-xl p-4 flex items-center justify-between gap-4">
          <div>
            <span class="text-[13px] font-semibold block mb-0.5 text-fg" id="drawer-perf-label" data-i18n="settings.perfTitle">Режим продуктивності</span>
            <span class="text-[11px] leading-snug block text-muted" data-i18n="settings.perfSub">
              Вимкни, щоб увімкнути «Рідке скло» з розмиттям і відблисками.
            </span>
          </div>
          <button
            id="drawer-perf-switch"
            type="button"
            role="switch"
            aria-labelledby="drawer-perf-label"
            aria-checked="true"
            class="toggle-switch w-11 h-6 rounded-full transition-colors relative shrink-0 cursor-pointer"
          >
            <span
              id="drawer-perf-knob"
              class="w-4 h-4 rounded-full transition-transform absolute top-1 left-1 bg-white"
            ></span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Drawer Footer -->
  <div class="pt-4">
    <button
      id="done-settings-btn"
      type="button"
      class="btn-primary w-full h-10 rounded-xl text-[13px] cursor-pointer"
      data-i18n="settings.close"
    >
      Готово
    </button>
  </div>
</aside>

<style>
  .theme-opt-btn,
  .drawer-lang-btn {
    color: var(--c-muted);
  }
  .theme-opt-btn.active,
  .drawer-lang-btn.active {
    background: var(--btn-bg);
    color: var(--btn-fg);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }
</style>
