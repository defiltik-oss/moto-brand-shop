---
/** Custom cursor elements (styled in global.css). Hidden on touch devices. */
---

<div data-cursor-halo class="pointer-events-none fixed top-0 left-0 z-[200] hidden [@media(hover:hover)_and_(pointer:fine)]:block" aria-hidden="true"></div>
<div data-cursor-dot class="pointer-events-none fixed top-0 left-0 z-[201] hidden h-1.5 w-1.5 rounded-full [@media(hover:hover)_and_(pointer:fine)]:block" aria-hidden="true"></div>
