---
import NavigationDrawer from "./NavigationDrawer.astro";

const sections = [
  { id: 'catalog', label: 'Каталог' },
  { id: 'media', label: 'YouTube' },
  { id: 'promo', label: 'Реклама' },
  { id: 'problems', label: 'Допомога' },
];
---

<header
  data-header-root
  class="apple-header sticky top-0 z-40 w-full transition-colors duration-200"
>
  <div class="relative mx-auto w-full max-w-[1140px] box-border px-3 sm:px-6">
    <!-- Полоска-індикатор свайпу для Telegram Mini App -->
    <div
      data-app-handlebar
      title="Потягніть вниз"
      class="flex cursor-grab items-center justify-center pt-1.5 pb-1 active:cursor-grabbing"
    >
      <div class="swipe-handlebar"></div>
    </div>

    <!-- Головний рядок шапки -->
    <div class="flex min-h-12 w-full min-w-0 flex-wrap items-center justify-between gap-x-2 gap-y-1 pb-1 lg:flex-nowrap lg:gap-x-3 lg:pb-0">
      <!-- Чистий логотип бренду -->
      <a
        href="#top"
        data-anchor-link="top"
        aria-label="Alexov Shop"
        class="flex shrink-0 items-center w-auto max-w-[120px] sm:max-w-[150px]"
      >
        <img
          data-header-logo
          src="/logo.png"
          alt="Alexov Shop"
          class="block h-4 sm:h-5 w-auto object-contain object-left transition-opacity duration-300"
        />
      </a>

      <nav id="header-section-nav" aria-label="Розділи сайту" data-i18n-aria="nav.sectionsBtn" class="order-last grid w-full grid-cols-4 gap-1 lg:order-none lg:flex lg:w-auto">
        {sections.map(({ id, label }) => (
          <a href={'#' + id} data-anchor-link={id} data-i18n={'nav.' + id} class="header-section-link pill-tab">{label}</a>
        ))}
      </nav>

      <div class="flex min-w-0 flex-1 items-center justify-end gap-1 sm:gap-2">
        <button
          type="button"
          id="header-theme-toggle"
          data-theme-toggle
          aria-label="Перемкнути тему"
          class="glass-sub hidden xl:flex h-8.5 cursor-pointer items-center justify-center gap-1.5 rounded-xl px-3 text-xs font-medium text-fg/90 hover:text-fg shrink-0"
        >
          <svg
            data-theme-icon="light"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path><path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path><path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <svg
            data-theme-icon="dark"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
          <span id="header-theme-label" data-theme-text data-i18n="header.themeDark" class="hidden text-xs font-medium 2xl:inline">
            Темна
          </span>
        </button>

        <!-- 1. Перемикач мови (UA / EN) -->
        <div
          class="glass-sub hidden sm:flex h-8.5 items-center rounded-xl p-0.5 text-[10px] sm:text-[11px] font-mono font-semibold shrink-0"
          role="group"
          aria-label="Вибір мови інтерфейсу"
        >
          <button
            type="button"
            data-lang-btn="uk"
            class="header-lang-btn active cursor-pointer rounded-lg px-1.5 sm:px-2.5 py-1 leading-none transition-all"
          >
            UA
          </button>
          <button
            type="button"
            data-lang-btn="en"
            class="header-lang-btn cursor-pointer rounded-lg px-1.5 sm:px-2.5 py-1 leading-none transition-all"
          >
            EN
          </button>
        </div>

        <button
          type="button"
          id="header-login-btn"
          aria-label="Увійти через Telegram"
          class="glass-sub flex h-8 sm:h-8.5 cursor-pointer items-center gap-1.5 rounded-xl px-2.5 sm:px-3 text-[11px] sm:text-xs font-semibold text-fg hover:border-sky-400/40 transition-all shrink-0"
        >
          <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          <span data-i18n="auth.signInTelegram" class="hidden min-[380px]:inline whitespace-nowrap">Увійти через Telegram</span>
        </button>

        <!-- 2B. Кнопка профілю (відкриває особистий кабінет райдера з балансом JET та рейтингом) -->
        <div id="header-profile-group" class="hidden items-center min-w-0 shrink">
          <!-- Кнопка профілю користувача -->
          <button
            type="button"
            id="header-profile-btn"
            aria-label="Особистий кабінет користувача"
            class="glass-sub flex h-8 sm:h-8.5 cursor-pointer items-center gap-1.5 rounded-xl px-1.5 sm:px-2.5 text-xs font-medium text-fg/95 hover:text-fg transition-all max-w-[120px] sm:max-w-[170px] min-w-0 overflow-hidden"
          >
            <span class="relative w-5.5 h-5.5 sm:w-6 sm:h-6 rounded-full p-[1px] bg-gradient-to-tr from-sky-400/75 via-white/60 to-emerald-400/75 shrink-0">
              <span class="w-full h-full rounded-full overflow-hidden bg-black/85 flex items-center justify-center">
                <img
                  id="header-user-avatar"
                  src=""
                  alt=""
                  class="w-full h-full object-cover hidden"
                />
                <span id="header-user-initials" class="font-mono text-[10px] font-bold text-white leading-none">A</span>
              </span>
            </span>
            <span id="header-user-name" class="text-[11px] sm:text-xs font-semibold text-fg truncate max-w-[70px] sm:max-w-[115px]">
              Rider
            </span>
          </button>
        </div>

        <button
          type="button"
          id="open-navigation-btn"
          aria-controls="navigation-drawer"
          aria-expanded="false"
          aria-label="Відкрити меню"
          data-i18n-aria="nav.openMenu"
          class="glass-sub flex h-8 w-8 sm:h-8.5 sm:w-8.5 shrink-0 cursor-pointer items-center justify-center rounded-xl text-fg/90 hover:text-fg"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <NavigationDrawer />

        <button
          type="button"
          id="open-settings-btn"
          data-open-settings
          aria-label="Налаштування"
          class="glass-sub flex h-8 w-8 sm:h-8.5 sm:w-8.5 shrink-0 cursor-pointer items-center justify-center rounded-xl text-fg/90 hover:text-fg"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .header-section-link {
    display: grid;
    min-height: 2.25rem;
    place-items: center;
    padding: .25rem .375rem;
    text-align: center;
    font-size: clamp(.6875rem, 2.8vw, .8125rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .header-section-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
    border-radius: .5rem;
  }

  .header-lang-btn {
    color: var(--c-muted);
  }
  .header-lang-btn:hover {
    color: var(--c-fg);
  }
  .header-lang-btn.active {
    background: var(--btn-bg);
    color: var(--btn-fg);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }
</style>
