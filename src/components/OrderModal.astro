---
---
<!-- Order Modal Backdrop & Dialog -->
<div
  id="order-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 opacity-0 pointer-events-none transition-opacity duration-200"
  aria-hidden="true"
  inert
>
  <div
    id="order-modal-panel"
    class="liquid-glass-elevated w-full rounded-3xl p-6 sm:p-7 flex flex-col"
  >
    <!-- Header -->
    <div class="drawer-heading flex items-start justify-between gap-4 pb-3 mb-4" style="box-shadow: inset 0 -1px 0 0 var(--c-divider);">
      <div>
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] block mb-1 text-muted">ALEXOV SHOP • ОФОРМЛЕННЯ</span>
        <h3 id="modal-product-title" class="text-[18px] font-semibold tracking-[-0.02em] text-fg">
          Оформлення замовлення
        </h3>
      </div>
      <button
        id="close-modal-btn"
        type="button"
        class="w-8 h-8 rounded-lg liquid-pill flex items-center justify-center transition-colors cursor-pointer shrink-0 text-muted hover:text-fg"
        aria-label="Закрити вікно"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="drawer-body">
    <!-- Step Indicators -->
    <div class="flex items-center gap-2 mb-4">
      <div id="step-indicator-1" class="flex-1 flex items-center gap-2 py-1.5 px-2.5 rounded-lg bg-sky-500/15 border border-sky-400/30 text-sky-400 font-mono text-[11px] font-semibold transition-all">
        <span class="w-4 h-4 rounded-full bg-sky-400 text-black text-[10px] font-black flex items-center justify-center shrink-0">1</span>
        <span class="truncate">Дані доставки</span>
      </div>
      <div id="step-indicator-2" class="flex-1 flex items-center gap-2 py-1.5 px-2.5 rounded-lg bg-white/5 border border-white/10 text-muted font-mono text-[11px] font-semibold transition-all">
        <span class="w-4 h-4 rounded-full bg-white/20 text-white text-[10px] font-black flex items-center justify-center shrink-0">2</span>
        <span class="truncate">Оплата та чек</span>
      </div>
    </div>

    <!-- Selected Item Summary Pill -->
    <div class="liquid-pill rounded-2xl p-3.5 mb-4 flex items-center justify-between border border-white/10">
      <div class="min-w-0 pr-3">
        <span class="font-mono text-[10px] uppercase tracking-[0.1em] block text-muted mb-0.5">Обрана позиція</span>
        <span id="modal-item-name" class="text-[13.5px] font-bold text-fg block truncate">Щиток на самокат «Vinnytsia Stunt Team»</span>
        <span id="modal-item-variant" class="font-mono text-[11px] text-sky-400 block mt-0.5">Колір: Білий</span>
      </div>
      <span id="modal-item-price" class="font-mono text-[17px] font-black text-fg shrink-0">300 ₴</span>
    </div>

    <!-- Main Order Form (Handles Both Steps) -->
    <form id="order-form" class="space-y-4">
      <input type="hidden" id="order-product-id" value="" />

      <!-- ================= STEP 1: DELIVERY DATA ================= -->
      <div id="order-step-1" class="space-y-3.5">
        <!-- Вибір кольору (для товарів з колірними опціями) -->
        <div id="modal-color-container">
          <label class="font-mono text-[10px] uppercase tracking-[0.1em] block mb-1.5 text-muted">
            Оберіть колір
          </label>
          <div class="grid grid-cols-2 gap-2" id="modal-color-selector">
            <button
              type="button"
              data-color="white"
              data-color-name="Білий"
              class="color-option-btn active py-2 px-3 rounded-xl font-mono text-[12px] font-semibold transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span class="w-3 h-3 rounded-full bg-white border border-black/30 shadow-sm shrink-0"></span>
              <span>Білий</span>
            </button>
            <button
              type="button"
              data-color="black"
              data-color-name="Чорний"
              class="color-option-btn py-2 px-3 rounded-xl font-mono text-[12px] font-semibold transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span class="w-3 h-3 rounded-full bg-zinc-900 border border-white/30 shadow-sm shrink-0"></span>
              <span>Чорний</span>
            </button>
          </div>
        </div>

        <!-- Вибір розміру (для одягу) -->
        <div id="modal-size-container" class="hidden">
          <label class="font-mono text-[10px] uppercase tracking-[0.1em] block mb-1.5 text-muted">
            Оберіть розмір
          </label>
          <div class="grid grid-cols-4 gap-2" id="size-selector">
            {['S', 'M', 'L', 'XL'].map((sz, i) => (
              <button
                type="button"
                data-size={sz}
                class={`size-btn py-2 rounded-lg font-mono text-[12px] font-semibold transition-all cursor-pointer ${i === 2 ? 'active' : ''}`}
              >
                {sz}
              </button>
            ))}
          </div>
        </div>

        <div>
          <label for="order-client-name" class="font-mono text-[10px] uppercase tracking-[0.1em] block mb-1 text-muted">
            <span data-i18n="order.fullName">Ім’я та прізвище</span> <span class="text-rose-400">*</span>
          </label>
          <input
            id="order-client-name"
            type="text"
            required
            autocomplete="off"
            value=""
            placeholder="Введіть ваше ім'я"
            class="hig-input w-full px-3.5 py-2.5 rounded-xl text-[13px]"
          />
        </div>

        <div>
          <label for="order-client-phone" class="font-mono text-[10px] uppercase tracking-[0.1em] block mb-1 text-muted">
            Номер телефону <span class="text-rose-400">*</span>
          </label>
          <input
            id="order-client-phone"
            type="tel"
            required
            placeholder="+380 (99) 000-00-00"
            class="hig-input w-full px-3.5 py-2.5 rounded-xl text-[13px]"
          />
        </div>

        <div>
          <label for="order-client-city" class="font-mono text-[10px] uppercase tracking-[0.1em] block mb-1 text-muted">
            Місто та відділення Нової Пошти <span class="text-rose-400">*</span>
          </label>
          <input
            id="order-client-city"
            type="text"
            required
            placeholder="Вінниця, Відділення №1"
            class="hig-input w-full px-3.5 py-2.5 rounded-xl text-[13px]"
          />
        </div>

        <div>
          <label for="order-client-tg" class="sr-only">Telegram @username</label>
          <input
            id="order-client-tg"
            name="tgUser"
            type="text"
            maxlength="33"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            placeholder="@username"
            class="hig-input w-full px-3.5 py-2.5 rounded-xl text-[13px]"
          />
        </div>

        <button type="button" data-open-terms data-i18n="terms.title" class="text-sm text-muted underline">Політика користування</button>

        <div class="pt-2 flex items-center justify-end gap-2.5">
          <button
            id="cancel-modal-btn"
            type="button"
            class="btn-secondary h-10 px-4 rounded-xl text-[13px] cursor-pointer"
          >
            Скасувати
          </button>
          <button
            id="order-next-step-btn"
            type="button"
            class="btn-primary h-10 px-5 rounded-xl text-[13px] font-semibold cursor-pointer flex items-center justify-center gap-1.5"
          >
            <span>Перейти до оплати</span>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- ================= STEP 2: PAYMENT & RECEIPT ================= -->
      <div id="order-step-2" class="hidden space-y-3.5">
        <!-- Блок реквізитів оплати -->
        <div class="liquid-pill rounded-2xl p-4 border border-white/10 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-white/10">
            <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-amber-400 font-bold">Реквізити для оплати</span>
            <span id="payment-amount-display" class="font-mono text-[13px] font-bold text-fg">300 грн</span>
          </div>

          <!-- Опція 1: Банка Monobank -->
          <div>
            <span class="font-mono text-[10px] uppercase text-muted block mb-1.5">Спосіб 1: Швидка оплата в Банку</span>
            <a
              id="open-monobank-jar-btn"
              href="https://send.monobank.ua/jar/6DpsRjriTZ"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary w-full h-10 rounded-xl text-[12.5px] font-semibold flex items-center justify-center gap-2 cursor-pointer shadow-md shadow-sky-500/15"
              style="background: linear-gradient(135deg, rgba(239,68,68,0.2) 0%, rgba(56,189,248,0.2) 100%); border: 1px solid rgba(255,255,255,0.2);"
            >
              <svg class="w-4 h-4 text-rose-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14h2v2h-2v-2zm0-10h2v8h-2V6z"/>
              </svg>
              <span>Відкрити Банку Monobank ↗</span>
            </a>
          </div>

          <!-- Опція 2: Номер картки -->
          <div>
            <span class="font-mono text-[10px] uppercase text-muted block mb-1.5">Спосіб 2: На картку за номером</span>
            <div class="glass-sub rounded-xl p-2.5 flex items-center justify-between gap-2 border border-white/10">
              <span class="font-mono text-[13px] font-bold text-fg tracking-wider select-all" id="card-number-val">4874 1000 3295 9606</span>
              <button
                type="button"
                id="copy-card-btn"
                class="glass-sub px-2.5 py-1 rounded-lg font-mono text-[11px] font-semibold text-sky-400 hover:text-white cursor-pointer transition-colors shrink-0 flex items-center gap-1"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
                <span id="copy-card-text">Копіювати</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Блок завантаження чека оплати (ОБОВ'ЯЗКОВО) -->
        <div>
          <label class="font-mono text-[10px] uppercase tracking-[0.1em] block mb-1.5 text-muted">
            Підтвердження оплати (Скріншот чека) <span class="text-rose-400">*</span>
          </label>

          <!-- Прихований інпут для файлу -->
          <input
            type="file"
            id="order-receipt-input"
            accept="image/*"
            class="hidden"
          />

          <!-- Кастомна область прикріплення файлу -->
          <div
            id="receipt-dropzone"
            class="liquid-pill rounded-2xl p-4 border border-dashed border-white/25 hover:border-sky-400/50 cursor-pointer transition-all flex flex-col items-center justify-center text-center group"
          >
            <!-- Стан 1: Файл ще не вибрано -->
            <div id="receipt-empty-view" class="flex flex-col items-center py-2">
              <div class="w-10 h-10 rounded-xl liquid-glass flex items-center justify-center mb-2 text-sky-400 group-hover:scale-105 transition-transform border border-white/10">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <span class="text-[12.5px] font-semibold text-fg block">Натисніть, щоб прикріпити чек оплати</span>
              <span class="font-mono text-[10px] text-muted block mt-0.5">Підтримуються формати: JPG, PNG, WEBP, HEIC</span>
            </div>

            <!-- Стан 2: Файл прикріплено -->
            <div id="receipt-selected-view" class="hidden w-full flex items-center justify-between gap-3">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-10 h-10 rounded-lg overflow-hidden bg-zinc-900 border border-white/20 shrink-0 flex items-center justify-center">
                  <img id="receipt-preview-img" src="" alt="Чек" class="w-full h-full object-cover hidden" />
                  <svg id="receipt-doc-icon" class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div class="text-left min-w-0">
                  <span id="receipt-file-name" class="text-[12px] font-bold text-fg block truncate">receipt.jpg</span>
                  <span id="receipt-file-size" class="font-mono text-[10px] text-emerald-400 block">Чек прикріплено ✓</span>
                </div>
              </div>
              <button
                type="button"
                id="receipt-change-btn"
                class="glass-sub px-2.5 py-1 rounded-lg font-mono text-[11px] text-muted hover:text-white shrink-0 cursor-pointer"
              >
                Змінити
              </button>
            </div>
          </div>
        </div>

        <div class="p-2.5 rounded-xl bg-white/[0.03] border border-white/10 flex items-start gap-2">
          <svg class="w-4 h-4 text-sky-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <p class="text-[11px] text-muted leading-tight">
            Кнопка підтвердження активується автоматично після прикріплення фотографії або скріншота чека.
          </p>
        </div>

        <div class="pt-2 flex items-center justify-between gap-2.5">
          <button
            id="order-prev-step-btn"
            type="button"
            class="btn-secondary h-10 px-4 rounded-xl text-[13px] cursor-pointer flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
            </svg>
            <span>Назад</span>
          </button>

          <!-- Кнопка блокується за замовчуванням (disabled), поки чек не завантажено -->
          <button
            id="order-submit-btn"
            type="submit"
            disabled
            class="btn-primary h-10 px-5 rounded-xl text-[13px] font-semibold flex items-center justify-center gap-2 opacity-50 cursor-not-allowed transition-all"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
            <span id="order-submit-text">Підтвердити замовлення</span>
          </button>
        </div>
      </div>
    </form>
    </div>
  </div>
</div>

<style>
  .size-btn,
  .color-option-btn {
    background: var(--lg-sub-fill);
    color: var(--c-muted);
    border: 1px solid var(--c-border);
  }
  .size-btn.active,
  .color-option-btn.active {
    background: var(--btn-bg);
    color: var(--btn-fg);
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
  }
</style>
