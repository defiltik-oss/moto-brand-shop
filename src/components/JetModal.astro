<section id="profile-jet" class="hidden" aria-labelledby="profile-wallet-title">
  <!-- Big Balance Display (No emojis, sleek cyber-rider SVG) -->
  <div class="liquid-pill rounded-2xl px-5 py-6 flex flex-col items-center text-center mb-4 relative overflow-hidden border border-sky-400/20">
    <!-- JET icon glow -->
    <div class="w-14 h-14 rounded-2xl liquid-glass flex items-center justify-center mb-3 shadow-[0_0_24px_rgba(56,189,248,0.25)] border border-sky-400/30">
      <svg class="w-7 h-7 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
      </svg>
    </div>
    <div class="flex items-baseline gap-2 mb-1">
      <span id="jet-modal-balance" class="font-mono text-[42px] font-black text-fg leading-none tracking-tight">100</span>
      <span class="font-mono text-[18px] font-bold text-sky-400">JET</span>
    </div>
    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted">Внутрішня валюта Alexov Shop</span>
  </div>

  <!-- Referral Section -->
  <div class="liquid-pill rounded-2xl p-4 mb-4">
    <div class="flex items-center gap-2 mb-2">
      <div class="w-6 h-6 rounded-lg liquid-glass flex items-center justify-center shrink-0 text-sky-400">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
        </svg>
      </div>
      <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-sky-400 font-bold">Реферальна програма</span>
    </div>
    <p class="text-[12px] text-muted mb-3 leading-relaxed">
      Запроси друга за своїм посиланням — ти та він отримаєте по <strong class="text-fg font-mono">+100 JET</strong>!
    </p>
    <button
      id="jet-copy-ref-link"
      type="button"
      class="btn-primary w-full h-10 rounded-xl text-[12.5px] font-semibold flex items-center justify-center gap-2 cursor-pointer"
      data-i18n="jet.refBtn"
    >
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
      </svg>
      <span>Запросити друга +100 JET</span>
    </button>
    <!-- Ref link display (hidden, appears after copy) -->
    <div id="jet-ref-link-display" class="hidden mt-3">
      <div class="glass-sub rounded-xl p-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
        </svg>
        <span class="font-mono text-[11px] text-fg truncate" id="jet-ref-link-text"></span>
      </div>
      <p class="text-[11px] text-emerald-400 mt-1.5 font-mono" data-i18n="jet.refCopied">Посилання скопійовано!</p>
    </div>
  </div>

  <section class="liquid-pill jet-farm-tile rounded-2xl p-4 mb-4" aria-labelledby="jet-farm-title">
    <div class="flex items-center justify-between gap-2">
      <h3 id="jet-farm-title" class="font-semibold">Щогодинна нагорода</h3>
      <span class="font-mono text-sm font-semibold">+50 JET</span>
    </div>
    <p id="jet-farm-countdown" class="my-2 text-sm tabular-nums" role="status"></p>
    <button id="jet-hourly-claim" type="button" class="liquid-pill px-4 py-2" disabled>Забрати JET</button>
  </section>

  <section class="liquid-pill rounded-2xl p-4 mb-4 text-center" aria-labelledby="jet-tap-title">
    <h3 id="jet-tap-title" class="font-semibold">Тапалка</h3>
    <p class="my-2 text-xs text-muted">+10 джетиків за тап · 100 джетиків = 1 JET</p>
    <button id="jet-tap" type="button" class="jet-tap-button liquid-pill mx-auto my-3" aria-label="Тапнути по маскоту" disabled>
      <img src="/mascot.png" alt="" width="104" height="104" class="object-contain" />
    </button>
    <p class="text-sm">Джетики: <strong id="jet-tap-units">—</strong></p>
    <button id="jet-tap-exchange" type="button" class="liquid-pill mt-2 px-4 py-2" disabled>Обміняти на JET</button>
    <p id="jet-tap-status" class="mt-2 text-xs text-muted" role="status"></p>
  </section>

  <!-- Transaction history -->
  <div id="jet-history-panel">
    <div class="flex items-center justify-between mb-3">
      <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted" data-i18n="jet.historyTitle">
        ІСТОРІЯ НАРАХУВАНЬ
      </span>
    </div>
    <div id="jet-transactions-loading" class="text-center py-5">
      <span class="font-mono text-[12px] text-muted" data-i18n="jet.historyLoading">Завантаження транзакцій...</span>
    </div>
    <div id="jet-transactions-list" class="space-y-2 max-h-[220px] overflow-y-auto pr-1 hidden">
      <!-- Rendered by JS -->
    </div>
  </div>

</section>
